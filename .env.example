# Copie para .env (ignorado pelo Git). Nunca coloque a credencial Google na extensão.
# Gere um token local: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ARTIGOFALADO_TOKEN=
# ID de 32 letras exibido em chrome://extensions para o ArtigoFalado.
EXTENSION_ID=
# Projeto com faturamento e Cloud Text-to-Speech API habilitados.
GOOGLE_CLOUD_PROJECT=
# Token OAuth temporário obtido localmente com gcloud auth print-access-token.
GOOGLE_ACCESS_TOKEN=
